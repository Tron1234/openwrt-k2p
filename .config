# K2P (MT7621) - parents use only, adblock-fast only
# For P3TERX Actions-OpenWrt / coolsnowwolf/lede
# Workflow runs `make defconfig`, so this minimal config will be expanded automatically.
# Do NOT add Clash / songloft / AdGuardHome / classic adblock here.

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_phicomm_k2p=y

# WiFi drivers for K2P (kept by device definition, listed explicitly so they are not dropped)
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt76x2=y

# LuCI + adblock-fast only (lighter than classic adblock, runs once then exits, DNS via dnsmasq)
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_adblock-fast=y

# Classic adblock explicitly off, do not build both
CONFIG_PACKAGE_luci-app-adblock=n
CONFIG_PACKAGE_adblock=n

# Explicitly off: proxy / heavy / music-unlock, to keep 128MB RAM / 16MB flash lean
CONFIG_PACKAGE_luci-app-adguardhome=n
CONFIG_PACKAGE_adguardhome=n
CONFIG_PACKAGE_luci-app-openclash=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-v2ray-server=n
CONFIG_PACKAGE_luci-app-dockerman=n
CONFIG_PACKAGE_luci-app-samba4=n
CONFIG_PACKAGE_luci-app-transmission=n
CONFIG_PACKAGE_luci-app-aria2=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-unblockmusic=n
